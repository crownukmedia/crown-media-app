<resources>
    <style name="Theme.CrownMedia.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/crown_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/crown_media_logo</item>
        <item name="windowSplashScreenAnimationDuration">150</item>
        <item name="postSplashScreenTheme">@style/Theme.CrownMedia</item>
    </style>

    <style name="Theme.CrownMedia" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/crown_primary</item>
        <item name="colorOnPrimary">@color/crown_background</item>
        <item name="colorSurface">@color/crown_surface</item>
        <item name="colorOnSurface">@color/crown_text</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:windowBackground">@color/crown_background</item>
        <item name="android:colorAccent">@color/crown_primary</item>
        <item name="android:navigationBarColor">@color/crown_background</item>
        <item name="android:statusBarColor">@color/crown_background</item>
    </style>
    <style name="Widget.Crown.NavButton" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:layout_width">match_parent</item><item name="android:layout_height">48dp</item>
        <item name="android:layout_marginBottom">5dp</item><item name="android:textSize">10sp</item>
        <item name="android:textColor">@color/white</item><item name="backgroundTint">@color/crown_surface</item>
        <item name="cornerRadius">10dp</item><item name="android:focusable">true</item>
    </style>
    <style name="Widget.Crown.ActionButton" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:layout_width">wrap_content</item><item name="android:layout_height">48dp</item>
        <item name="android:layout_marginStart">10dp</item><item name="android:textColor">@color/crown_gold</item>
        <item name="strokeColor">@color/crown_border</item><item name="cornerRadius">12dp</item>
    </style>
    <style name="Widget.Crown.MobileNavButton" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:layout_width">0dp</item><item name="android:layout_height">56dp</item><item name="android:layout_weight">1</item>
        <item name="android:layout_marginStart">2dp</item><item name="android:layout_marginEnd">2dp</item><item name="android:minWidth">0dp</item><item name="android:minHeight">48dp</item>
        <item name="android:background">@drawable/bg_mobile_nav</item><item name="backgroundTint">@null</item>
        <item name="android:textColor">@color/mobile_nav_text</item><item name="android:textSize">11sp</item><item name="android:textStyle">bold</item>
        <item name="android:paddingStart">2dp</item><item name="android:paddingEnd">2dp</item><item name="android:insetTop">0dp</item><item name="android:insetBottom">0dp</item>
    </style>
    <style name="Widget.Crown.IconButton" parent="Widget.AppCompat.ImageButton">
        <item name="android:layout_width">48dp</item><item name="android:layout_height">48dp</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item><item name="android:padding">12dp</item>
        <item name="android:tint">@color/white</item><item name="android:focusable">true</item>
    </style>
    <style name="Widget.Crown.TextInputLayout" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="android:layout_width">match_parent</item><item name="android:layout_height">wrap_content</item><item name="android:layout_marginBottom">8dp</item>
        <item name="boxBackgroundColor">@color/crown_surface</item><item name="boxStrokeColor">@color/crown_field_stroke</item><item name="hintTextColor">@color/crown_text_secondary</item>
        <item name="boxCornerRadiusTopStart">12dp</item><item name="boxCornerRadiusTopEnd">12dp</item><item name="boxCornerRadiusBottomStart">12dp</item><item name="boxCornerRadiusBottomEnd">12dp</item>
    </style>
    <style name="Widget.Crown.TextInputLayout.ExposedDropdown" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu">
        <item name="android:layout_width">match_parent</item><item name="android:layout_height">wrap_content</item><item name="android:layout_marginBottom">8dp</item>
        <item name="boxBackgroundColor">@color/crown_surface</item><item name="boxStrokeColor">@color/crown_field_stroke</item><item name="hintTextColor">@color/crown_text_secondary</item>
        <item name="boxCornerRadiusTopStart">12dp</item><item name="boxCornerRadiusTopEnd">12dp</item><item name="boxCornerRadiusBottomStart">12dp</item><item name="boxCornerRadiusBottomEnd">12dp</item>
    </style>
    <style name="Widget.Crown.PrimaryButton" parent="Widget.MaterialComponents.Button">
        <item name="android:layout_width">wrap_content</item><item name="android:layout_height">50dp</item>
        <item name="android:textColor">#07090E</item><item name="backgroundTint">@color/crown_gold</item><item name="cornerRadius">12dp</item>
    </style>
    <style name="Widget.Crown.PrimaryButton.FullWidth" parent="Widget.Crown.PrimaryButton">
        <item name="android:layout_width">match_parent</item><item name="android:layout_height">56dp</item>
        <item name="android:textSize">16sp</item><item name="android:textStyle">bold</item><item name="android:focusable">true</item>
    </style>
    <style name="Widget.Crown.SecondaryButton.FullWidth" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:layout_width">match_parent</item><item name="android:layout_height">56dp</item>
        <item name="android:textColor">@color/white</item><item name="strokeColor">@color/crown_primary_bright</item><item name="cornerRadius">12dp</item>
        <item name="android:textSize">16sp</item><item name="android:textStyle">bold</item><item name="android:focusable">true</item>
    </style>
    <style name="Widget.Crown.TextButton.FullWidth" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:layout_width">match_parent</item><item name="android:layout_height">52dp</item>
        <item name="android:textColor">@color/crown_text_secondary</item><item name="android:focusable">true</item>
    </style>
</resources>
