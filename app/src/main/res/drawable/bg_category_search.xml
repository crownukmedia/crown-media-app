<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/crown_surface" />
            <corners android:radius="10dp" />
            <stroke android:width="3dp" android:color="@color/crown_primary_bright" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/crown_surface" />
            <corners android:radius="10dp" />
            <stroke android:width="1dp" android:color="#FF30384A" />
        </shape>
    </item>
</selector>
