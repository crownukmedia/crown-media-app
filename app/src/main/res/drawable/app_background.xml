<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="315"
                android:centerColor="#102340"
                android:endColor="#060B16"
                android:startColor="#07172B" />
        </shape>
    </item>
    <item android:gravity="center">
        <shape android:shape="oval">
            <size
                android:width="820dp"
                android:height="820dp" />
            <gradient
                android:centerColor="#6035C8FF"
                android:endColor="#0006111D"
                android:gradientRadius="420dp"
                android:startColor="#00143B75"
                android:type="radial" />
        </shape>
    </item>
</layer-list>
