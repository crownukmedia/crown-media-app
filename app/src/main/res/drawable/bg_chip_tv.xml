<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape><solid android:color="@color/crown_primary_tv"/><corners android:radius="24dp"/><stroke android:width="3dp" android:color="@color/white"/></shape>
    </item>
    <item android:state_selected="true">
        <shape><solid android:color="@color/crown_primary_tv"/><corners android:radius="24dp"/><stroke android:width="2dp" android:color="@color/crown_primary_bright"/></shape>
    </item>
    <item><shape><solid android:color="@color/crown_surface"/><corners android:radius="24dp"/><stroke android:width="1dp" android:color="@color/crown_border"/></shape></item>
</selector>
