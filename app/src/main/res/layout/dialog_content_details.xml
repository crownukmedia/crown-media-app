<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
        <ImageView android:id="@+id/detail_backdrop" android:layout_width="match_parent" android:layout_height="140dp" android:contentDescription="@null" android:scaleType="centerCrop" android:visibility="gone" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:baselineAligned="false" android:orientation="horizontal">
            <ImageView android:id="@+id/detail_artwork" android:layout_width="120dp" android:layout_height="180dp" android:background="@drawable/bg_logo_surface" android:contentDescription="@null" android:padding="2dp" android:scaleType="centerCrop" />
            <TextView android:id="@+id/detail_body" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="18dp" android:layout_weight="1" android:lineSpacingExtra="3dp" android:textColor="@color/crown_text" android:textSize="15sp" />
        </LinearLayout>
        <TextView android:id="@+id/detail_cast_label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:text="@string/cast" android:textColor="@color/crown_text" android:textSize="16sp" android:textStyle="bold" android:visibility="gone" />
        <HorizontalScrollView android:id="@+id/detail_cast_scroll" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:clipToPadding="false" android:fillViewport="false" android:scrollbars="none" android:visibility="gone">
            <LinearLayout android:id="@+id/detail_cast" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" />
        </HorizontalScrollView>
    </LinearLayout>
</ScrollView>
