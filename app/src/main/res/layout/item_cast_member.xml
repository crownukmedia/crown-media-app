<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="88dp" android:layout_height="wrap_content" android:layout_marginEnd="12dp" android:gravity="center_horizontal" android:orientation="vertical">
    <ImageView android:id="@+id/cast_image" android:layout_width="72dp" android:layout_height="72dp" android:background="@drawable/bg_logo_surface" android:contentDescription="@null" android:scaleType="centerCrop" android:visibility="gone" />
    <TextView android:id="@+id/cast_name" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:ellipsize="end" android:gravity="center" android:maxLines="2" android:textColor="@color/crown_text_secondary" android:textSize="12sp" />
</LinearLayout>
