<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/top_bar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="54dp"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingEnd="4dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/brand_logo"
            android:layout_width="58dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_logo_surface"
            android:contentDescription="@string/app_name"
            android:adjustViewBounds="true"
            android:padding="4dp"
            android:scaleType="fitCenter"
            android:src="@drawable/crown_media_logo_header" />

        <LinearLayout
            android:id="@+id/title_block"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="8dp"
            android:paddingEnd="4dp">

            <TextView
                android:id="@+id/screen_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/app_name"
                android:textColor="@color/white"
                android:textSize="19sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/screen_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/brand_tagline"
                android:textColor="@color/crown_text_secondary"
                android:textSize="13sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/action_more"
            style="@style/Widget.Crown.IconButton"
            android:contentDescription="@string/more_options"
            android:src="@drawable/ic_more_vert" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/search_row"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="12dp"
        android:layout_marginBottom="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/top_bar">

        <EditText
            android:id="@+id/search_box"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:autofillHints="none"
            android:background="@drawable/bg_field"
            android:hint="@string/search_everything"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:paddingHorizontal="16dp"
            android:singleLine="true"
            android:textColor="@color/white"
            android:textColorHint="@color/crown_text_secondary" />

        <ImageButton
            android:id="@+id/action_search_clear"
            style="@style/Widget.Crown.IconButton"
            android:layout_marginStart="4dp"
            android:contentDescription="@string/clear_search"
            android:src="@drawable/ic_close" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/category_list"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:clipToPadding="false"
        android:paddingStart="12dp"
        android:paddingEnd="4dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/search_row" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/content_grid"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:padding="8dp"
        app:layout_constraintBottom_toTopOf="@id/side_nav"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/category_list" />

    <ProgressBar
        android:id="@+id/page_progress"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="12dp"
        android:indeterminateTint="@color/crown_primary_bright"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/side_nav"
        app:layout_constraintEnd_toEndOf="parent" />

    <LinearLayout
        android:id="@+id/state_panel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="32dp"
        android:accessibilityLiveRegion="polite"
        android:gravity="center"
        android:orientation="vertical"
        app:layout_constraintBottom_toTopOf="@id/side_nav"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/search_row">

        <TextView
            android:id="@+id/state_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold" />

        <ProgressBar
            android:id="@+id/progress"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginTop="12dp"
            android:indeterminateTint="@color/crown_primary_bright" />

        <TextView
            android:id="@+id/state_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:textColor="@color/crown_text_secondary" />

        <Button
            android:id="@+id/state_action"
            style="@style/Widget.Crown.PrimaryButton"
            android:layout_marginTop="20dp"
            android:text="@string/try_again" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/side_nav"
        android:layout_width="0dp"
        android:layout_height="64dp"
        android:background="@color/crown_surface"
        android:importantForAccessibility="yes"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingHorizontal="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <Button android:id="@+id/nav_home" style="@style/Widget.Crown.MobileNavButton" android:text="@string/nav_home" />
        <Button android:id="@+id/nav_live" style="@style/Widget.Crown.MobileNavButton" android:text="@string/nav_live" />
        <Button android:id="@+id/nav_movies" style="@style/Widget.Crown.MobileNavButton" android:text="@string/nav_movies" />
        <Button android:id="@+id/nav_series" style="@style/Widget.Crown.MobileNavButton" android:text="@string/nav_series" />
        <Button android:id="@+id/nav_search" style="@style/Widget.Crown.MobileNavButton" android:text="@string/nav_search" />
    </LinearLayout>

    <include
        android:id="@+id/login_panel"
        layout="@layout/view_login"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:id="@+id/desktop_controls"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <View android:id="@+id/nav_account" android:layout_width="1dp" android:layout_height="1dp" />
        <View android:id="@+id/nav_settings" android:layout_width="1dp" android:layout_height="1dp" />
        <View android:id="@+id/nav_exit" android:layout_width="1dp" android:layout_height="1dp" />
        <View android:id="@+id/action_reload" android:layout_width="1dp" android:layout_height="1dp" />
        <View android:id="@+id/action_playlist" android:layout_width="1dp" android:layout_height="1dp" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
