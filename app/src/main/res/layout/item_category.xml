<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content" android:layout_height="48dp" android:layout_marginEnd="8dp"
    android:background="@drawable/bg_chip" android:clickable="true" android:focusable="true" android:gravity="center_vertical" android:orientation="horizontal">
    <TextView android:id="@+id/category_name" android:layout_width="wrap_content" android:layout_height="match_parent" android:gravity="center" android:paddingHorizontal="12dp" android:textColor="@color/white" android:textSize="14sp" android:textStyle="bold" />
    <TextView android:id="@+id/category_count" android:layout_width="wrap_content" android:layout_height="match_parent" android:gravity="center" android:paddingEnd="10dp" android:textColor="@color/crown_text_secondary" android:textSize="11sp" android:textStyle="bold" android:visibility="gone" />
    <ImageButton android:id="@+id/category_actions" style="@style/Widget.Crown.IconButton" android:layout_width="48dp" android:layout_height="48dp" android:minWidth="0dp" android:padding="10dp" android:contentDescription="@string/category_options" android:src="@drawable/ic_more_vert" />
</LinearLayout>
