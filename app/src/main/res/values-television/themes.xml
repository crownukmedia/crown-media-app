<resources>
    <style name="Theme.CrownMedia" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/crown_primary_tv</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSurface">@color/crown_surface</item>
        <item name="colorOnSurface">@color/crown_text</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:windowBackground">@color/crown_background</item>
        <item name="android:colorAccent">@color/crown_primary_tv</item>
        <item name="android:navigationBarColor">@color/crown_background</item>
        <item name="android:statusBarColor">@color/crown_background</item>
        <item name="android:alertDialogTheme">@style/ThemeOverlay.CrownMedia.TvDialog</item>
    </style>

    <style name="ThemeOverlay.CrownMedia.TvDialog" parent="Theme.Material3.Dark.Dialog.Alert">
        <item name="android:windowMinWidthMajor">68%</item>
        <item name="android:windowMinWidthMinor">68%</item>
        <item name="android:windowBackground">@drawable/bg_panel</item>
        <item name="android:textColorPrimary">@color/white</item>
        <item name="android:textColorSecondary">@color/crown_text_secondary</item>
        <item name="android:textSize">16sp</item>
        <item name="android:listPreferredItemHeightSmall">56dp</item>
        <item name="materialAlertDialogTitleTextStyle">@style/TextAppearance.Crown.TvDialogTitle</item>
        <item name="materialAlertDialogBodyTextStyle">@style/TextAppearance.Crown.TvDialogBody</item>
        <item name="buttonBarPositiveButtonStyle">@style/Widget.Crown.TvDialogButton</item>
        <item name="buttonBarNegativeButtonStyle">@style/Widget.Crown.TvDialogButton</item>
        <item name="buttonBarNeutralButtonStyle">@style/Widget.Crown.TvDialogButton</item>
    </style>

    <style name="TextAppearance.Crown.TvDialogTitle" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">24sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.Crown.TvDialogBody" parent="TextAppearance.MaterialComponents.Body1">
        <item name="android:textColor">@color/crown_text_secondary</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="Widget.Crown.NavButton" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:layout_marginBottom">2dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/tv_nav_text</item>
        <item name="backgroundTint">@color/tv_nav_background</item>
        <item name="strokeColor">@color/tv_button_stroke</item>
        <item name="strokeWidth">1dp</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:focusable">true</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <style name="Widget.Crown.ActionButton" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">56dp</item>
        <item name="android:layout_marginStart">12dp</item>
        <item name="android:textColor">@color/tv_button_text</item>
        <item name="backgroundTint">@color/tv_button_background</item>
        <item name="strokeColor">@color/tv_button_stroke</item>
        <item name="strokeWidth">3dp</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Widget.Crown.PrimaryButton" parent="Widget.MaterialComponents.Button">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">56dp</item>
        <item name="android:minWidth">144dp</item>
        <item name="android:textColor">@color/tv_button_text</item>
        <item name="backgroundTint">@color/tv_button_background</item>
        <item name="strokeColor">@color/tv_button_stroke</item>
        <item name="strokeWidth">3dp</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Widget.Crown.TvDialogButton" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:minWidth">128dp</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/tv_button_text</item>
        <item name="backgroundTint">@color/tv_button_background</item>
        <item name="strokeColor">@color/tv_button_stroke</item>
        <item name="strokeWidth">3dp</item>
        <item name="cornerRadius">12dp</item>
    </style>

    <style name="Widget.Crown.TvDialogButton.Destructive" parent="Widget.Crown.TvDialogButton">
        <item name="android:textColor">@color/crown_error</item>
    </style>
</resources>
