<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent">

    <LinearLayout android:id="@+id/side_nav" android:layout_width="120dp" android:layout_height="0dp"
        android:background="#E60A0D14" android:gravity="center_horizontal" android:orientation="vertical" android:paddingHorizontal="16dp" android:paddingVertical="12dp"
        app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent">
        <ImageView android:id="@+id/brand_logo" android:layout_width="72dp" android:layout_height="54dp" android:layout_marginBottom="10dp" android:background="@drawable/bg_logo_surface" android:contentDescription="@string/app_name" android:adjustViewBounds="true" android:padding="5dp" android:scaleType="fitCenter" android:src="@drawable/crown_media_logo_header" />
        <Button android:id="@+id/nav_home" style="@style/Widget.Crown.NavButton" android:text="@string/nav_home" />
        <Button android:id="@+id/nav_live" style="@style/Widget.Crown.NavButton" android:text="@string/nav_live" />
        <Button android:id="@+id/nav_movies" style="@style/Widget.Crown.NavButton" android:text="@string/nav_movies" />
        <Button android:id="@+id/nav_series" style="@style/Widget.Crown.NavButton" android:text="@string/nav_series" />
        <Button android:id="@+id/nav_search" style="@style/Widget.Crown.NavButton" android:text="@string/nav_search" />
        <Space android:layout_width="1dp" android:layout_height="0dp" android:layout_weight="1" />
        <Button android:id="@+id/nav_account" style="@style/Widget.Crown.NavButton" android:text="@string/account" />
        <Button android:id="@+id/nav_settings" style="@style/Widget.Crown.NavButton" android:text="@string/settings" />
        <Button android:id="@+id/nav_exit" style="@style/Widget.Crown.NavButton" android:text="@string/exit" />
    </LinearLayout>

    <LinearLayout android:id="@+id/top_bar" android:layout_width="0dp" android:layout_height="76dp" android:gravity="center_vertical"
        android:orientation="horizontal" android:paddingStart="28dp" android:paddingEnd="40dp" app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/side_nav" app:layout_constraintTop_toTopOf="parent">
        <LinearLayout android:id="@+id/title_block" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
            <TextView android:id="@+id/screen_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="1" android:text="@string/app_name" android:textColor="@color/white" android:textSize="30sp" android:textStyle="bold" />
            <TextView android:id="@+id/screen_subtitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="1" android:text="@string/brand_tagline" android:textColor="@color/crown_text_secondary" android:textSize="15sp" />
        </LinearLayout>
        <LinearLayout android:id="@+id/search_row" android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal" android:visibility="gone">
            <EditText android:id="@+id/search_box" android:layout_width="300dp" android:layout_height="52dp" android:autofillHints="none" android:background="@drawable/bg_field" android:hint="@string/search_everything" android:imeOptions="actionSearch" android:inputType="text" android:paddingHorizontal="16dp" android:singleLine="true" android:textColor="@color/white" android:textColorHint="@color/crown_text_secondary" android:textSize="16sp" />
            <ImageButton android:id="@+id/action_search_clear" style="@style/Widget.Crown.IconButton" android:contentDescription="@string/clear_search" android:src="@drawable/ic_close" android:visibility="gone" />
        </LinearLayout>
        <Button android:id="@+id/action_reload" style="@style/Widget.Crown.ActionButton" android:text="@string/reload" />
        <Button android:id="@+id/action_playlist" style="@style/Widget.Crown.ActionButton" android:text="@string/playlist" />
        <ImageButton android:id="@+id/action_more" style="@style/Widget.Crown.IconButton" android:contentDescription="@string/more_options" android:src="@drawable/ic_more_vert" android:visibility="gone" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView android:id="@+id/category_list" android:layout_width="0dp" android:layout_height="56dp" android:layout_marginTop="8dp" android:clipToPadding="false" android:paddingHorizontal="24dp" android:paddingVertical="5dp"
        app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toEndOf="@id/side_nav" app:layout_constraintTop_toBottomOf="@id/top_bar" />
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/content_grid" android:layout_width="0dp" android:layout_height="0dp" android:clipToPadding="false" android:paddingStart="24dp" android:paddingTop="16dp" android:paddingEnd="40dp" android:paddingBottom="28dp"
        app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toEndOf="@id/side_nav" app:layout_constraintTop_toBottomOf="@id/category_list" />

    <ProgressBar android:id="@+id/page_progress" android:layout_width="36dp" android:layout_height="36dp" android:layout_margin="20dp"
        android:indeterminateTint="@color/crown_primary_bright" android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintEnd_toEndOf="parent" />

    <LinearLayout android:id="@+id/state_panel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="center" android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toEndOf="@id/side_nav" app:layout_constraintTop_toBottomOf="@id/category_list">
        <TextView android:id="@+id/state_title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="center" android:textColor="@color/white" android:textSize="24sp" android:textStyle="bold" />
        <ProgressBar android:id="@+id/progress" android:layout_width="48dp" android:layout_height="48dp" android:layout_marginTop="12dp" android:indeterminateTint="@color/crown_primary_bright" />
        <TextView android:id="@+id/state_message" android:layout_width="480dp" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:gravity="center" android:textColor="@color/crown_text_secondary" android:textSize="16sp" />
        <Button android:id="@+id/state_action" style="@style/Widget.Crown.PrimaryButton" android:layout_marginTop="20dp" android:text="@string/try_again" />
    </LinearLayout>
    <include
        android:id="@+id/login_panel"
        layout="@layout/view_login"
        android:layout_width="600dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <View android:id="@+id/desktop_controls" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
