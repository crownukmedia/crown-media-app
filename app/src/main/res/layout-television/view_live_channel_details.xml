<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/live_channel_details"
    android:layout_width="0dp"
    android:layout_height="0dp"
    android:background="@color/crown_background"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="14dp"
    android:paddingEnd="32dp"
    android:paddingBottom="18dp"
    android:visibility="gone">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/crown_surface">

        <ImageView
            android:id="@+id/live_channel_artwork"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:padding="24dp"
            android:scaleType="fitCenter" />

        <uk.crownmedia.player.InlineLivePreviewView
            android:id="@+id/live_channel_preview"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </FrameLayout>

    <TextView
        android:id="@+id/live_channel_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/white"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/live_channel_epg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:ellipsize="end"
        android:maxLines="2"
        android:textColor="@color/crown_text_secondary"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/live_channel_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:textColor="@color/crown_primary_bright"
        android:textSize="13sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:baselineAligned="false"
        android:gravity="start"
        android:orientation="horizontal"
        android:weightSum="3">

        <Button android:id="@+id/live_channel_play" style="@style/Widget.Crown.ActionButton" android:layout_width="0dp" android:layout_weight="1" android:layout_marginStart="0dp" android:ellipsize="end" android:maxLines="1" android:minWidth="0dp" android:text="@string/play_channel" />
        <Button android:id="@+id/live_channel_favourite" style="@style/Widget.Crown.ActionButton" android:layout_width="0dp" android:layout_weight="1" android:layout_marginStart="8dp" android:ellipsize="end" android:maxLines="1" android:minWidth="0dp" android:text="@string/favourite" />
        <Button android:id="@+id/live_channel_group" style="@style/Widget.Crown.ActionButton" android:layout_width="0dp" android:layout_weight="1" android:layout_marginStart="8dp" android:ellipsize="end" android:maxLines="1" android:minWidth="0dp" android:text="@string/add_to_group" />
    </LinearLayout>
</LinearLayout>
