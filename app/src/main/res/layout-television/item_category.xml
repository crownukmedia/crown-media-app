<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginHorizontal="4dp" android:layout_marginVertical="3dp" android:background="@drawable/bg_tv_category_item" android:clickable="true" android:focusable="true" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="14dp" android:paddingEnd="12dp">
    <TextView android:id="@+id/category_name" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:ellipsize="end" android:gravity="center_vertical" android:maxLines="1" android:textColor="@color/white" android:textSize="15sp" android:textStyle="bold" />
    <TextView android:id="@+id/category_count" android:layout_width="wrap_content" android:layout_height="match_parent" android:gravity="center_vertical" android:paddingStart="8dp" android:textColor="@color/crown_text_secondary" android:textSize="12sp" android:textStyle="bold" android:visibility="gone" />
    <ImageButton android:id="@+id/category_actions" style="@style/Widget.Crown.IconButton" android:contentDescription="@string/category_options" android:src="@drawable/ic_more_vert" android:visibility="gone" />
</LinearLayout>
